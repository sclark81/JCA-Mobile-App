<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JCA.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="JCA Mobile">

    <!-- Login Page (shown when not authenticated) -->
    <ShellContent x:Name="LoginShellContent"
                  Route="LoginPage"
                  ContentTemplate="{DataTemplate local:LoginPage}"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False" />

    <!-- Main App TabBar (shown after authentication) -->
    <TabBar x:Name="MainTabBar"
            Route="MainPage"
            BackgroundColor="{StaticResource PrimaryColor}">

        <Tab Title="Home" Icon="home_icon.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>

        <Tab Title="Maintenance" Icon="wrench_icon.png">
            <ShellContent ContentTemplate="{DataTemplate local:MaintenancePage}" />
        </Tab>

    </TabBar>

</Shell>
